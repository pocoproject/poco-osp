if(ENABLE_OSP)
	# Sources
	file(GLOB _poco_osp_srcs_g "src/*.cpp")
	POCO_SOURCES_AUTO(_poco_osp_srcs ${_poco_osp_srcs_g})

	# Headers
	file(GLOB_RECURSE _poco_osp_hdrs_g "include/*.h")
	POCO_HEADERS_AUTO(_poco_osp_srcs ${_poco_osp_hdrs_g})

	# Version Resource
	if(MSVC AND BUILD_SHARED_LIBS)
		source_group("Resources" FILES ${PROJECT_SOURCE_DIR}/DLLVersion.rc)
		list(APPEND _poco_osp_srcs ${PROJECT_SOURCE_DIR}/DLLVersion.rc)
	endif()

	add_library(OSP ${_poco_osp_srcs})
	add_library(Poco::OSP ALIAS OSP)
	set_target_properties(OSP
		PROPERTIES
		VERSION ${SHARED_LIBRARY_VERSION} SOVERSION ${SHARED_LIBRARY_VERSION}
		OUTPUT_NAME PocoOSP
		DEFINE_SYMBOL OSP_EXPORTS
	)

	target_link_libraries(OSP PUBLIC Poco::Foundation Poco::XML Poco::Util PRIVATE Poco::Zip)
	target_include_directories(OSP
		PUBLIC
			$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
			$<INSTALL_INTERFACE:include>
		PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src
	)

	unset(_poco_osp_srcs_g)
	unset(_poco_osp_srcs)
	unset(_poco_osp_hdrs_g)

	POCO_INSTALL(OSP)
	POCO_GENERATE_PACKAGE(OSP)
endif()

