<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>OSP Secure Mail Service</name>
    <symbolicName>com.appinf.osp.mail.secure</symbolicName>
    <version>1.0.2</version>
    <vendor>Applied Informatics</vendor>
    <copyright>(c) 2017-2026, Applied Informatics Software Engineering GmbH</copyright>
    <activator>
      <class>Poco::OSP::Mail::SecureBundleActivator</class>
      <library>com.appinf.osp.mail.secure</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>000</runLevel>
    <dependency>
      <symbolicName>com.appinf.osp.mail</symbolicName>
      <version>[1.0.0, 2.0.0)</version>
    </dependency>
    <dependency>
      <symbolicName>poco.net.ssl</symbolicName>
      <version>[1.3.0, 2.0.0)</version>
    </dependency>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib,
  </code>
  <files>
    bundle/*
  </files>
</bundlespec>
