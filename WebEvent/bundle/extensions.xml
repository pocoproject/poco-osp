<extensions>
  <!-- The web server authenticates and authorizes the upgrade request before the handler sees it, with an
       Authorization header carrying HTTP Basic credentials or a bearer token, or, if osp.web.event.session names a
       web session, with the cookie of a session logged in to it. osp.web.event.permission is the permission a user
       needs, by default "*", every authenticated user of an existing account; an empty permission skips
       authentication. The web server refuses an upgrade from an origin that is neither the server's own nor listed in
       osp.web.event.allowedOrigins before it authenticates the request. -->
  <extension point="osp.web.server.requesthandler" path="${path}" permission="${osp.web.event.permission:-*}" session="${osp.web.event.session:-}" allowWebSocketOrigin="${osp.web.event.allowedOrigins:-}" class="Poco::OSP::WebEvent::WebEventRequestHandlerFactory" allowSpecialization="none" hidden="true" description="${description}"/>
</extensions>
