#! /bin/sh
#
# mkdoc
#
# Builds PocoDoc from the POCO that the build pulls, generates the reference
# documentation of the repository into <output-dir>, with the PocoDoc output
# in <output-dir>.log, and checks it with checkdoc.
#
# usage: mkdoc <build-dir> <output-dir> [<cmake-option>...]
#
# The CMake options go to the configure of <build-dir>, for example
# -DPOCO_OSP_POCO_VERSION=latest or -DPOCO_OSP_POCO_REPOSITORY=<directory>.
#

set -e

if [ $# -lt 2 ] ; then
	echo "usage: $0 <build-dir> <output-dir> [<cmake-option>...]" >&2
	exit 64
fi

build=$1
output=${2%/}
shift 2

base=$(cd "$(dirname "$0")/.." && pwd)
read -r version <"$base/VERSION"

cmake -S "$base" -B "$build" -DCMAKE_BUILD_TYPE=Release -DENABLE_POCODOC=ON -DENABLE_CPPPARSER=ON "$@"
cmake --build "$build" --target PocoDoc --parallel

cacheValue()
{
	sed -n "s/^$1:[A-Z]*=//p" "$build/CMakeCache.txt"
}

pocoBase=$(cacheValue Poco_SOURCE_DIR)
cxx=$(cacheValue CMAKE_CXX_COMPILER)
# PocoDoc splits the compiler options at commas.
includes=""
sysroot=$(cacheValue CMAKE_OSX_SYSROOT)
if [ -n "$sysroot" ] ; then
	includes="-isysroot,$sysroot"
fi
opensslInclude=$(cacheValue OPENSSL_INCLUDE_DIR)
if [ -n "$opensslInclude" ] ; then
	includes="$includes,-I$opensslInclude"
fi

rm -rf "$output"
mkdir -p "$output"
log="$output.log"
"$build/bin/PocoDoc" \
	--config="$base/PocoDoc/cfg/mkdoc-poco-osp.xml" \
	-DPocoOSPBase="$base" \
	-DPocoBase="$pocoBase" \
	-DCXX="$cxx" \
	-DIncludes="$includes" \
	-DPocoDoc.output="$output" \
	-DPocoDoc.version="$version" \
	2>&1 | tee "$log"

# PocoDoc exits with 0 also when the compiler fails on a header or it cannot parse one.
if grep -q -E ': (fatal )?error: ' "$log" || ! grep -q '] 0 errors\.$' "$log" ; then
	echo "PocoDoc or the compiler reported errors, see $log" >&2
	exit 1
fi

"$base/PocoDoc/checkdoc" "$base" "$output" "$log"
