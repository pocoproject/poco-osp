<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>${bundle.name}</name>
    <symbolicName>com.appinf.osp.shell.commands</symbolicName>
    <version>1.3.0</version>
    <vendor>${bundle.vendor}</vendor>
    <copyright>${bundle.copyright}</copyright>
    <lazyStart>false</lazyStart>
    <runLevel>100</runLevel>
    <dependency>
      <symbolicName>com.appinf.osp.shell</symbolicName>
      <version>[1.1.0,3.0.0)</version>
    </dependency>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
  <files>
    bundle/*
  </files>
</bundlespec>
