<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>${bundle.name}</name>
    <symbolicName>com.appinf.osp.shell</symbolicName>
    <version>2.0.0</version>
    <vendor>${bundle.vendor}</vendor>
    <copyright>${bundle.copyright}</copyright>
    <lazyStart>false</lazyStart>
    <runLevel>100</runLevel>
    <activator>
      <class>Poco::OSP::Shell::ShellBundleActivator</class>
      <library>com.appinf.osp.shell</library>
    </activator>
    <dependency>
      <symbolicName>poco.net</symbolicName>
      <version>[1.3.0,2.0.0)</version>
    </dependency>
    <dependency>
      <symbolicName>osp.core</symbolicName>
      <version>[1.1.0,2.0.0)</version>
    </dependency>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    ../../${bin}/PocoOSPShell${64}.dll,
    ../../${bin}/PocoOSPShell${64}d.dll,
    ../../${bin}/PocoOSPShell${64}d.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
    ../../lib/${osName}/${osArch}/libPocoOSPShell.so.*,
    ../../lib/${osName}/${osArch}/libPocoOSPShelld.so.*,
    ../../lib/${osName}/${osArch}/libPocoOSPShell.*.dylib,
    ../../lib/${osName}/${osArch}/libPocoOSPShelld.*.dylib
  </code>
  <files>
    bundle/*
  </files>
</bundlespec>
