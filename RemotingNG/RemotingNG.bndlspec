<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>POCO Remoting NG Library</name>
    <symbolicName>poco.remotingng</symbolicName>
    <version>1.11.10</version>
    <vendor>Applied Informatics</vendor>
    <copyright>(c) 2006-2026, Applied Informatics Software Engineering GmbH</copyright>
    <lazyStart>false</lazyStart>
    <runLevel>000</runLevel>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    ../../${bin}/PocoRemotingNG${64}.dll,
    ../../${bin}/PocoRemotingNG${64}d.dll,
    ../../${bin}/PocoRemotingNG${64}d.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib,
    ../../lib/${osName}/${osArch}/libPocoRemotingNG.so.*,
    ../../lib/${osName}/${osArch}/libPocoRemotingNGd.so.*,
    ../../lib/${osName}/${osArch}/libPocoRemotingNG.*.dylib,
    ../../lib/${osName}/${osArch}/libPocoRemotingNGd.*.dylib
  </code>
</bundlespec>
