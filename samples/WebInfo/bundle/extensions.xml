<extensions>
  <extension point="osp.web.server.directory" path="/info/css" resource="css" allowSpecialization="none" hidden="true"/>
  <extension point="osp.web.server.directory" path="/info/images" resource="images" allowSpecialization="none" hidden="true"/>
  <!-- The page shows host names, addresses and the process ID, so only users who log in see it. -->
  <extension point="osp.web.server.requesthandler" path="/info" class="InfoHandlerFactory" library="com.appinf.osp.samples.webinfo" allowSpecialization="owner" description="OSP Server Information" realm="OSP" permission="*"/>
</extensions>