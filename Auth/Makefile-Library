#
# Makefile-Library
#
# Makefile for Poco OSPAuth Library
#

include $(POCO_BASE)/build/rules/global

ifdef POCO_OSP_AUTH_ENABLE_LDAP
CXXFLAGS += -DPOCO_OSP_AUTH_ENABLE_LDAP -DLDAP_DEPRECATED=1
SYSLIBS += -lldap
endif

# Only announce the configuration on an actual build, not on clean/distclean,
# where the Makefile is parsed (and $(info ...) fires) without building.
ifeq (,$(filter clean distclean,$(MAKECMDGOALS)))
ifdef POCO_OSP_AUTH_ENABLE_LDAP
$(info Building OSP Auth with LDAP support)
else
$(info Building OSP Auth without LDAP support)
endif
endif

objects = AuthAdminService PooledAuthAdminService AbstractLDAPAuthAdminService AuthNotification

ifdef POCO_OSP_AUTH_ENABLE_LDAP
objects += LDAPClient
endif

target         = PocoOSPAuth
target_version = 1
target_libs    = PocoOSP PocoNet PocoUtil PocoXML PocoFoundation

include $(POCO_BASE)/build/rules/lib
