#
# Makefile
#
# Makefile for Poco OSPAuthTwoFactor Bundle
#

include $(POCO_BASE)/build/rules/global
include $(POCOPLUS_BASE)/OSP/BundleCreator/BundleCreator.make

objects = TwoFactorBundleActivator TwoFactorServiceImpl

target         = com.appinf.osp.auth.twofactor
target_version = 1
target_libs    = PocoOSPAuthTwoFactor PocoOSPAuth PocoOSP PocoZip PocoCrypto PocoUtil PocoXML PocoFoundation

postbuild      = $(SET_LD_LIBRARY_PATH) $(BUNDLE_TOOL) -n$(OSNAME) -a$(OSARCH) -o../../bundles TwoFactorBundle.bndlspec

include $(POCO_BASE)/build/rules/dylib
