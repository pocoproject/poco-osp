<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>OSP Authentication and Authorization Service (SQL)</name>
    <symbolicName>com.appinf.osp.auth.data</symbolicName>
    <version>1.11.1</version>
    <vendor>Applied Informatics</vendor>
    <copyright>(c) 2012-2024, Applied Informatics Software Engineering GmbH</copyright>
    <activator>
      <class>Poco::OSP::Auth::Data::AuthBundleActivator</class>
      <library>com.appinf.osp.auth.data</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>010</runLevel>
    <module>
      <symbolicName>osp.auth</symbolicName>
      <version>1.7.0</version>
    </module>
    <dependency>
      <symbolicName>com.appinf.osp.auth</symbolicName>
      <version>[1.5.0, 2.0.0)</version>
    </dependency>
    <dependency>
      <symbolicName>poco.data</symbolicName>
      <version>[1.3.0, 2.0.0)</version>
    </dependency>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    ../../../${bin}/PocoOSPAuthData${64}.dll,
    ../../../${bin}/PocoOSPAuthData${64}d.dll,
    ../../../${bin}/PocoOSPAuthData${64}d.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib,
    ../../../lib/${osName}/${osArch}/libPocoOSPAuthData.so.*,
    ../../../lib/${osName}/${osArch}/libPocoOSPAuthDatad.so.*,
    ../../../lib/${osName}/${osArch}/libPocoOSPAuthData.*.dylib,
    ../../../lib/${osName}/${osArch}/libPocoOSPAuthDatad.*.dylib
  </code>
  <files>
    bundle/*
  </files>
</bundlespec>
