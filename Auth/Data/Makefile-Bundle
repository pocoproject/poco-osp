#
# Makefile
#
# Makefile for Poco OSPAuth Data Bundle
#

include $(POCO_BASE)/build/rules/global
include $(POCOPLUS_BASE)/OSP/BundleCreator/BundleCreator.make

objects = AuthBundleActivator

target         = com.appinf.osp.auth.data
target_version = 1
target_libs    = PocoOSPAuthData PocoOSPAuth PocoOSP PocoData PocoNet PocoUtil PocoXML PocoJSON PocoFoundation

postbuild      = $(SET_LD_LIBRARY_PATH) $(BUNDLE_TOOL) -n$(OSNAME) -a$(OSARCH) -o../../bundles DataBundle.bndlspec

include $(POCO_BASE)/build/rules/dylib
